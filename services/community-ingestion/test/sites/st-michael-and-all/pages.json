ight elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"16cc5a7\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n <div class=\"elementor-container elementor-column-gap-default\">\n <div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-9735adc\" data-id=\"9735adc\" data-element_type=\"column\" data-e-type=\"column\">\n <div class=\"elementor-widget-wrap\">\n </div>\n </div>\n </div>\n </section>\n <section class=\"elementor-section elementor-top-section elementor-element elementor-element-e04f1f4 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"e04f1f4\" data-element_type=\"section\" data-e-type=\"section\">\n <div class=\"elementor-container elementor-column-gap-default\">\n <div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-3e453a1\" data-id=\"3e453a1\" data-element_type=\"column\" data-e-type=\"column\">\n <div class=\"elementor-widget-wrap elementor-element-populated\">\n <div class=\"elementor-element elementor-element-87d4640 elementor-widget elementor-widget-spacer\" data-id=\"87d4640\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-spacer\">\n <div class=\"elementor-spacer-inner\"></div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </section>\n <section class=\"elementor-section elementor-top-section elementor-element elementor-element-a5f9587 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"a5f9587\" data-element_type=\"section\" data-e-type=\"section\">\n <div class=\"elementor-container elementor-column-gap-default\">\n <div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-e01e808\" data-id=\"e01e808\" data-element_type=\"column\" data-e-type=\"column\">\n <div class=\"elementor-widget-wrap elementor-element-populated\">\n <div class=\"elementor-element elementor-element-f7c6211 elementor-widget elementor-widget-heading\" data-id=\"f7c6211\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n <div class=\"elementor-widget-container\">\n <h1 class=\"elementor-heading-title elementor-size-default\">Upcoming Events</h1> </div>\n </div>\n <div class=\"elementor-element elementor-element-9aa28f4 elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"9aa28f4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n <div class=\"elementor-widget-container\">\n Visitors and newcomers are always welcome! </div>\n </div>\n <div class=\"elementor-element elementor-element-bdf1f3c elementor-widget elementor-widget-spacer\" data-id=\"bdf1f3c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-spacer\">\n <div class=\"elementor-spacer-inner\"></div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </section>\n <section class=\"elementor-section elementor-top-section elementor-element elementor-element-f930272 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"f930272\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n <div class=\"elementor-container elementor-column-gap-default\">\n <div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-76b3dc9\" data-id=\"76b3dc9\" data-element_type=\"column\" data-e-type=\"column\">\n <div class=\"elementor-widget-wrap elementor-element-populated\">\n <section class=\"elementor-section elementor-inner-section elementor-element elementor-element-1bb1b03e elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"1bb1b03e\" data-element_type=\"section\" data-e-type=\"section\">\n <div class=\"elementor-container elementor-column-gap-default\">\n <div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-16ea162d\" data-id=\"16ea162d\" data-element_type=\"column\" data-e-type=\"column\">\n <div class=\"elementor-widget-wrap elementor-element-populated\">\n <div class=\"elementor-element elementor-element-3026851 elementor-position-inline-start elementor-view-default elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"3026851\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-icon-box-wrapper\">\n <div class=\"elementor-icon-box-icon\">\n <span class=\"elementor-icon elementor-animation-grow\">\n <i aria-hidden=\"true\" class=\"far fa-calendar-alt\"></i> </span>\n </div>\n <div class=\"elementor-icon-box-content\">\n <h3 class=\"elementor-icon-box-title\">\n <span>\n September 13th &amp; 20th </span>\n </h3>\n <p class=\"elementor-icon-box-description\">\n <b>What Does It Mean to Be an Episcopalian</b><br>Garrison Keillor has described Episcopalians as a people who have a “deep love for fellowship, coffee and long goodbyes”; they tend to be “joyful, modest singers who never take themselves too seriously.” While this may indeed be true, to begin our formation year we take two sessions to dive deeper into our identity as Episcopalians and how this guides both our faith and the call to be disciples and apostles in the world.<br>\nJoin us on Sunday in the Parish Hall at 9am. </p>\n </div>\n </div>\n </div>\n </div>\n <div class=\"elementor-element elementor-element-cef5079 elementor-position-inline-start elementor-view-default elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"cef5079\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-icon-box-wrapper\">\n <div class=\"elementor-icon-box-icon\">\n <span class=\"elementor-icon elementor-animation-grow\">\n <i aria-hidden=\"true\" class=\"far fa-calendar-alt\"></i> </span>\n </div>\n <div class=\"elementor-icon-box-content\">\n <h3 class=\"elementor-icon-box-title\">\n <span>\n September 27th </span>\n </h3>\n <p class=\"elementor-icon-box-description\">\n <b>The Apostles’ Creed</b><br>\nFrom the suggestion box, we will revisit the Apostles’ Creed. Many Christian scholars believe that this is the earliest creed of the early church, with evidence of its “formal” use in the 4th century and likely earlier. This creed is thought to be a foundational part of the catechism used by early followers as they prepared for baptism. We will look at its structure and meaning as well as its current use in our liturgies and prayers, with plenty of time for questions and reflections. Join us on Sunday in the Parish Hall at 9am. </p>\n </div>\n </div>\n </div>\n </div>\n <div class=\"elementor-element elementor-element-07cd959 elementor-position-inline-start elementor-view-default elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"07cd959\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-icon-box-wrapper\">\n <div class=\"elementor-icon-box-icon\">\n <span class=\"elementor-icon elementor-animation-grow\">\n <i aria-hidden=\"true\" class=\"far fa-calendar-alt\"></i> </span>\n </div>\n <div class=\"elementor-icon-box-content\">\n <h3 class=\"elementor-icon-box-title\">\n <span>\n Church Cookbook Fundraiser! </span>\n </h3>\n <p class=\"elementor-icon-box-description\">\n <b>100% of all sales goes to support the church.</b><br>\nJoin us in putting together a St. Michael and All Angels church cookbook. We will be selling these starting in December 2026, and they will make great Christmas gifts. We’re asking for everyone to submit 1-5 recipes for the cookbook. Submissions should be sent to the parish office, someone@example.org by <b>October 1st</b> for inclusion. Help us make this a wonderful experience for our church family! </p>\n </div>\n </div>\n </div>\n </div>\n <div class=\"elementor-element elementor-element-c771202 elementor-position-inline-start elementor-view-default elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"c771202\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-icon-box-wrapper\">\n <div class=\"elementor-icon-box-icon\">\n <span class=\"elementor-icon elementor-animation-grow\">\n <i aria-hidden=\"true\" class=\"far fa-calendar-alt\"></i> </span>\n </div>\n <div class=\"elementor-icon-box-content\">\n <h3 class=\"elementor-icon-box-title\">\n <span>\n Sunday, September 27th </span>\n </h3>\n <p class=\"elementor-icon-box-description\">\n <b>Feast of St. Michael and All Angels</b><br>The Feast Day for St. Michael and All Angels is traditionally observed on September 29. However, we will \"transfer\" this feast day to Sunday, September 27 so that we can celebrate our patron saint, and all the angels, during our Sunday worship. Following our service, we will have a BBQ lunch featuring some of the most well-known sauces from Kansas City. We will also introduce our ministry leaders for the coming year; this is your opportunity to explore and discuss our various ministries and accept their invitation to become more involved in our parish life.<br>All are welcome! We hope to see you there! </p>\n </div>\n </div>\n </div>\n </div>\n <div class=\"elementor-element elementor-element-f9b3288 elementor-position-inline-start elementor-view-default elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"f9b3288\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-icon-box-wrapper\">\n <div class=\"elementor-icon-box-icon\">\n <span class=\"elementor-icon elementor-animation-grow\">\n <i aria-hidden=\"true\" class=\"far fa-calendar-alt\"></i> </span>\n </div>\n <div class=\"elementor-icon-box-content\">\n <h3 class=\"elementor-icon-box-title\">\n <span>\n Sunday, October 4th </span>\n </h3>\n <p class=\"elementor-icon-box-description\">\n <b>Feast of St. Francis of Assisi - Blessing of the Animals</b><br>Bring your friends, family, and neighbors and have them bring their four-footed companions to St. Michael and All Angels for the annual animal blessing! We will be giving away prizes and there will be treats for all the animals that come. Don't miss this opportunity to make a joyful noise and bring your animals and your friends with animals for this special service and blessing in the church at 10am. </p>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </section>\n <div class=\"elementor-element elementor-element-2d87e44 elementor-widget elementor-widget-spacer\" data-id=\"2d87e44\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n <div class=\"elementor-widget-container\">\n <div class=\"elementor-spacer\">\n <div class=\"elementor-spacer-inner\"></div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </div>\n </section>\n </div>\n</body></html>"
  }
