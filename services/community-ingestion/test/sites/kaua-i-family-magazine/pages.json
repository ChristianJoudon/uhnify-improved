   "text": "<!DOCTYPE html><html lang=\"en\"><head>\n <title>Kaua'i Family Magazine - Fall 2026 Fun Family Happenings</title>\n</head>\n<body>\n <main role=\"main\">\n <header>\n <div class=\"title-fall\">\n <span>F</span><span>A</span><span>L</span><span>L</span>\n </div>\n <h1 class=\"title-main\">FUN FAMILY<br>HAPPENINGS</h1>\n </header>\n <div class=\"months-container\">\n <section class=\"month-august\" aria-labelledby=\"heading-august\">\n <h2 id=\"heading-august\">AUGUST</h2>\n <div class=\"events-grid\">\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Ultimate Trail Run</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-08-01T07:00\">Sat., Aug. 1, 7am</time><br>\n <span itemprop=\"location\">Ōma'o Track</span><br>\n <a href=\"https://Ultimatehawaiiantrailrun.com\" itemprop=\"url\">Ultimatehawaiiantrailrun.com</a>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Heiva i Kaua'i</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-08-01\">Sat., Aug. 1</time> &amp; <time itemprop=\"endDate\" datetime=\"2026-08-02\">Sun., Aug. 2</time>, 9am-5pm<br>\n Tahitian Dance Competition<br>\n <span itemprop=\"location\">Kapa'a Beach Park</span><br>\n Food &amp; craft vendors<br>\n Admission $8; 12 &amp; under free<br>\n <a href=\"https://Heivakauai.com\" itemprop=\"url\">Heivakauai.com</a>\n </p>\n </article>\n </div>\n <div class=\"disclaimer\">\n Events are subject to change without notice. Always call event first to confirm.\n </div>\n </section>\n <section class=\"month-september\" aria-labelledby=\"heading-september\">\n <h2 id=\"heading-september\">SEPTEMBER</h2>\n <div class=\"events-grid\">\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Kaua'i Mokihana Festival</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-09-20\">Sept. 20-26</time><br>\n A week-long celebration of Hawaiian culture; education, music, &amp; hula competition<br>\n <a href=\"https://Maliefoundation.org\" itemprop=\"url\">Maliefoundation.org</a>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">International Peace Day</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-09-21T15:00\">Mon., Sept. 21, 3pm-7pm</time><br>\n Parade Walk from Sparky's Garden to Kaua'i Soto Zen's Kannon Peace Statue<br>\n <a href=\"https://KauaiSotoZen.com\" itemprop=\"url\">KauaiSotoZen.com</a>\n </p>\n </article>\n </div>\n </section>\n <section class=\"month-october\" aria-labelledby=\"heading-october\">\n <h2 id=\"heading-october\">OCTOBER</h2>\n <div class=\"events-grid\">\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Grove Farm Crafts Fair &amp; Farmers Market</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-03T09:30\">Sat., Oct. 3, 9:30am-12:30pm</time><br>\n <span itemprop=\"location\">Puhi Park</span>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Kaua'i Brewers Festival</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-03T15:00\">Sat., Oct. 3, 3pm-6pm</time><br>\n <span itemprop=\"location\">Kress Street, Līhu'e</span>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">ALOHA Kaua'i Yoga Festival</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-03T08:00\">Sat., Oct. 3, 8am-4:30pm</time><br>\n <span itemprop=\"location\">Kaua'i Shores Hotel</span><br>\n <a href=\"https://Alohafestival.org\" itemprop=\"url\">Alohafestival.org</a>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Kaua'i Matsuri Festival</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-09\">Fri., Oct. 9</time>, Aloha Banquet<br>\n <time itemprop=\"endDate\" datetime=\"2026-10-10\">Sat., Oct. 10</time>, 9am-3pm<br>\n A Japanese Cultural Festival<br>\n <span itemprop=\"location\">Kaua'i War Memorial Convention Hall</span>-FREE<br>\n <a href=\"https://Kauaijcs.org\" itemprop=\"url\">Kauaijcs.org</a>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Līhu'e Senior Center Craft Fair</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-10T09:00\">Sat., Oct. 10, 9am-1pm</time><br>\n <span itemprop=\"location\">Līhu'e Neighborhood Center</span>\n </p>\n </article>\n <article class=\"event-card\" itemscope=\"\" itemtype=\"https://schema.org/Event\">\n <h3 itemprop=\"name\">Kaua'i Chocolate &amp; Coffee Festival</h3>\n <p>\n <time itemprop=\"startDate\" datetime=\"2026-10-18T10:00\">Sun., Oct. 18, 10am-4pm</time><br>\n <span itemprop=\"location\">Kilohana Luau Pavillion</span>\n </p>\n </article>\n </div>\n </section>\n <section class=\"month-november\" aria-labelledby=\"heading-november\">\n <h2 id=\"heading-november\">NOVEMBER</h2>\n <div class=\"events-grid\">\n </div>\n </section>\n </div>\n </main>\n</body></html>"
