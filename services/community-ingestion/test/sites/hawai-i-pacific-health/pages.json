   "text": "<!DOCTYPE html><html lang=\"en-us\"><head>\n<title>Events, Classes &amp; Support Groups | Hawaiʻi Pacific Health</title>\n</head>\n<body data-serverside-gpc=\"False\">\n\t<div class=\"pageshell\" data-theme=\"default\" data-url=\"default\">\n<a class=\"sr-only\" href=\"/\">Skip to main content</a>\n<header class=\"global-header\">\n\t<div class=\"wrapper\">\n <div class=\"global-header__layout\">\n <div class=\"global-header__brand\">\n <a class=\"brand brand--default\" href=\"/\" description=\"Click link to visit the Hawaiʻi Pacific Health homepage\">\n <div class=\"sr-only\">Hawaiʻi Pacific Health Logo</div>\n </a>\n </div>\n <div class=\"global-header__toggle\">\n <button aria-controls=\"global-navigation\" aria-expanded=\"false\" class=\"menu-toggle js-menu-toggle\">\n <span></span>\n <span></span>\n <span></span>\n <span class=\"sr-only\">Toggle Menu Visibility</span>\n </button>\n </div>\n <div class=\"global-header__nav js-navigation\" id=\"global-navigation\">\n </div>\n </div>\n\t</div>\n</header>\n <div id=\"skip-to-main\" class=\"pageshell__layout\">\n <main id=\"main\" class=\"pageshell__main\">\n<figure class=\"marquee default\">\n\t<div class=\"marquee__layout\">\n <figcaption class=\"marquee__banner\">\n <div class=\"wrapper\">\n <div class=\"marquee__banner-layout\">\n<nav aria-label=\"breadcrumb\">\n\t<ol class=\"breadcrumbs\" aria-label=\"Breadcrumb\">\n <li aria-label=\"breadcrumb\">\n <a class=\"link\" href=\"/patient-resources/\">Patient Resources</a>\n </li>\n <li aria-current=\"page\">Calendar</li>\n\t</ol>\n</nav>\n </div>\n </div>\n </figcaption>\n <div class=\"marquee__alerts\">\n </div>\n\t</div>\n\t<figcaption class=\"marquee__main\">\n <div class=\"text-only text-only--default component component--md\">\n <div class=\"wrapper\">\n <div class=\"text-only__layout\">\n <h1 class=\"heading heading--h1\">\n Events, Classes &amp; Support Groups\n </h1>\n <div class=\"richtext rhythm\">\n\t<a class=\" link button button--outline\" href=\"/patient-resources/calendar/events/\">Events</a>\n\t<a class=\" link button button--outline\" href=\"/patient-resources/calendar/classes/\">Classes</a>\n\t<a class=\" link button button--outline\" href=\"/patient-resources/calendar/support-groups/\">Support Groups</a>\n </div>\n </div>\n </div>\n </div>\n\t</figcaption>\n</figure>\n<div id=\"\" class=\"card-deck card-deck--blog component component--no-padding component--flush-top \">\n\t<div class=\"wrapper\">\n <div class=\"card-deck__layout\">\n <div class=\"card-deck__heading\">\n <h2 class=\"heading heading--h3\">Featured Events</h2>\n </div>\n <ul class=\"card-deck__cards\">\n<li class=\"card\">\n\t<a href=\"/patient-resources/calendar/events/kapiolani-radiothon-for-kids/\">\n <article>\n <header class=\"card__heading rhythm rhythm--small\">\n <h3 class=\"heading card__heading-text\">\n Kapiʻolani Radiothon for Kids\n </h3>\n <div class=\"richtext rhythm card__subheading-text\">\n Tune in to the 20th annual Kapiʻolani Radiothon for Kids and help raise critical funds for Hawaiʻi's only Children's Miracle Network hospital.\n </div>\n </header>\n </article>\n\t</a>\n</li>\n<li class=\"card\">\n\t<a href=\"/patient-resources/calendar/classes/infant-care-grandparents-caregivers/\">\n <article>\n <header class=\"card__heading rhythm rhythm--small\">\n <h3 class=\"heading card__heading-text\">\n Infant Care for Grandparents &amp; Caregivers (with Infant CPR)\n </h3>\n <div class=\"richtext rhythm card__subheading-text\">\n This class is designed to educate grandparents and caregivers on the latest updates and current findings on how to care for a newborn. \n </div>\n </header>\n </article>\n\t</a>\n</li>\n<li class=\"card\">\n\t<a href=\"/patient-resources/calendar/support-groups/breast-cancer/\">\n <article>\n <header class=\"card__heading rhythm rhythm--small\">\n <h3 class=\"heading card__heading-text\">\n Breast Cancer Virtual Support Group\n </h3>\n <div class=\"richtext rhythm card__subheading-text\">\n The Breast Cancer Support Group meets online for patients who are receiving breast cancer treatment and for breast cancer survivors.\n </div>\n </header>\n </article>\n\t</a>\n</li>\n </ul>\n </div>\n\t</div>\n</div>\n<form class=\"form card-deck--calendar\" method=\"post\" action=\"/umbraco/surface/calendarcards/Search\">\n\t<div class=\"card-deck card-deck--list component component--2xl event-deck event-deck--list\">\n <div class=\"wrapper\">\n <div class=\"card-deck__layout\">\n <div class=\"card-deck__heading\">\n <h2 class=\"heading heading--h2\">All Events, Classes and Support Groups</h2>\n </div>\n <div class=\"card-deck__utility\">\n </div>\n <ul class=\"card-deck__cards\">\n\t<li class=\"event-card\">\n <article class=\"event-card__layout\">\n <a href=\"/patient-resources/calendar/classes/car-seat-checks-oahu/\">\n </a>\n <header class=\"event-card__header\">\n <h2 class=\"heading heading--h3 event-card__heading\" headinglevel=\"h3\">\n <a href=\"/patient-resources/calendar/classes/car-seat-checks-oahu/\" class=\"link\">Car Seat Checks - Oʻahu</a>\n </h2>\n </header>\n <div class=\"event-card__date\">\n </div>\n <div class=\"event-card__copy\">\n <ul class=\"event-card__time-loc\">\n <li class=\"area\">Oʻahu</li>\n </ul>\n <div class=\"event-card__desc\">\n <div class=\"richtext rhythm\">\n Meet with a Kapiʻolani Certified Child Passenger Safety Technician for a free 30-45 minute car seat inspection. \n </div>\n </div>\n <ul class=\"event-card__meta\">\n <li class=\"type\">Class</li>\n <li class=\"attend-type\">By Appointment Only</li>\n <li class=\"free\">free</li>\n </ul>\n </div>\n </article>\n\t</li>\n\t<li class=\"event-card\">\n <article class=\"event-card__layout\">\n <a href=\"/patient-resources/calendar/classes/car-seat-checks-virtual/\">\n </a>\n <header class=\"event-card__header\">\n <h2 class=\"heading heading--h3 event-card__heading\" headinglevel=\"h3\">\n <a href=\"/patient-resources/calendar/classes/car-seat-checks-virtual/\" class=\"link\">Car Seat Checks - Virtual</a>\n </h2>\n </header>\n <div class=\"event-card__date\">\n </div>\n <div class=\"event-card__copy\">\n <ul class=\"event-card__time-loc\">\n </ul>\n <div class=\"event-card__desc\">\n <div class=\"richtext rhythm\">\n Connect online with a Kapiʻolani Certified Child Passenger Safety Technician for a free 30-45 minute session. \n </div>\n </div>\n <ul class=\"event-card__meta\">\n <li class=\"type\">Class</li>\n <li class=\"attend-type\">Virtual</li>\n <li class=\"free\">free</li>\n </ul>\n </div>\n </article>\n\t</li>\n\t<li class=\"event-card\">\n <article class=\"event-card__layout\">\n <a href=\"/patient-resources/calendar/classes/prepared-childbirth-kapiolani/\">\n </a>\n <header class=\"event-card__header\">\n <h2 class=\"heading heading--h3 event-card__heading\" headinglevel=\"h3\">\n <a href=\"/patient-resources/calendar/classes/prepared-childbirth-kapiolani/\" class=\"link\">Prepared Childbirth at Kapiʻolani</a>\n </h2>\n </header>\n <div class=\"event-card__date\">\n <time datetime=\"2026-09-19\">\n <span class=\"month\">Sep</span>\n <span class=\"day\">19</span>\n <span class=\"year\">2026</span>\n </time>\n </div>\n <div class=\"event-card__copy\">\n <ul class=\"event-card__time-loc\">\n <li class=\"time\">Sat 9 a.m.-1:30 p.m.</li>\n <li class=\"area\">Oʻahu</li>\n </ul>\n <div class=\"event-card__desc\">\n <div class=\"richtext rhythm\">\n Excited about the big day? Not sure what to expect? This three-class series at Kapiʻolani Medical Center for Women &amp; Children is designed for expectant parents in their final trimester of pregnancy. \n </div>\n </div>\n <ul class=\"event-card__meta\">\n <li class=\"type\">Class</li>\n <li class=\"attend-type\">In Person</li>\n </ul>\n </div>\n </article>\n\t</li>\n\t<li class=\"event-card\">\n <article class=\"event-card__layout\">\n <a href=\"/patient-resources/calendar/support-groups/prostate-cancer/\">\n </a>\n <header class=\"event-card__header\">\n <h2 class=\"heading heading--h3 event-card__heading\" headinglevel=\"h3\">\n <a href=\"/patient-resources/calendar/support-groups/prostate-cancer/\" class=\"link\">Prostate Cancer Support Group</a>\n </h2>\n </header>\n <div class=\"event-card__date\">\n <time datetime=\"2026-09-21\">\n <span class=\"month\">Sep</span>\n <span class=\"day\">21</span>\n <span class=\"year\">2026</span>\n </time>\n </div>\n <div class=\"event-card__copy\">\n <ul class=\"event-card__time-loc\">\n <li class=\"time\">Mon 7 p.m.-9 p.m.</li>\n </ul>\n <div class=\"event-card__desc\">\n <div class=\"richtext rhythm\">\n A free support group&nbsp;in partnership with Pali Momi Medical Center for prostate cancer patients, spouses and significant others is available.\n </div>\n </div>\n <ul class=\"event-card__meta\">\n <li class=\"type\">Support Group</li>\n <li class=\"attend-type\">Virtual</li>\n <li class=\"free\">free</li>\n </ul>\n </div>\n </article>\n\t</li>\n\t<li class=\"event-card\">\n <article class=\"event-card__layout\">\n <a href=\"/patient-resources/calendar/classes/childbirth-parent-education/\">\n </a>\n <header class=\"event-card__header\">\n <h2 class=\"heading heading--h3 event-card__heading\" headinglevel=\"h3\">\n <a href=\"/patient-resources/calendar/classes/childbirth-parent-education/\" class=\"link\">Childbirth and Parent Education - Kauaʻi</a>\n </h2>\n </header>\n <div class=\"event-card__date\">\n <time datetime=\"2026-09-23\">\n <span class=\"month\">Sep</span>\n <span class=\"day\">23</span>\n <span class=\"year\">2026</span>\n </time>\n </div>\n <div class=\"event-card__copy\">\n <ul class=\"event-card__time-loc\">\n <li class=\"time\">Wed 5:30 p.m.-7:30 p.m.</li>\n <li class=\"area\">Kauaʻi</li>\n </ul>\n <div class=\"event-card__desc\">\n <div class=\"richtext rhythm\">\n Learn how to prepare for labor, birth, and early parenthood in a class with other expectant parents. This is a free class offered by Wilcox Medical Center, intended for those planning to give birth on Kauaʻi.\n </div>\n </div>