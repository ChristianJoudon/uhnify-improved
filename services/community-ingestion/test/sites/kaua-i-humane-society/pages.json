\">\n <div class=\"mobile-header-inner hidden-md-up\">\n <div class=\"container\">\n <ul class=\"mobile-header-items nav pull-left\">\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"mobile-logo\"><a href=\"https://kauaihumane.org/\" title=\"Kaua’i Humane Society\"></a></div> </div>\n </li>\n </ul>\n <ul class=\"mobile-header-items nav pull-right\">\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <a class=\"mobile-bar-toggle\" href=\"#\"><i class=\"fa fa-bars\"></i></a> </div>\n </li>\n </ul>\n </div>\n </div>\n </div>\n <div class=\"mobile-bar animate-from-top\">\n <a class=\"mobile-bar-toggle close\" href=\"#\"></a>\n <div class=\"mobile-bar-inner\">\n <div class=\"container\">\n <ul class=\"mobile-bar-items nav flex-column mobile-bar-middle\">\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"mobile-logo\"><a href=\"https://kauaihumane.org/\" title=\"Kaua’i Humane Society\"></a></div> </div>\n </li>\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <button data-blackbaud-optimized-form-id=\"229f760c-8924-49ad-8105-05a12f6df46a\"> Donate Today </button> </div>\n </li>\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"breno-mobile-main-menu\"></div> </div>\n </li>\n </ul>\n </div>\n </div>\n </div>\n <div id=\"page\" class=\"breno-wrapper\">\n <header class=\"breno-header\">\n <div class=\"header-inner hidden-sm-down\">\n <div class=\"logobar clearfix\">\n <div class=\"custom-container logobar-inner\">\n <ul class=\"logobar-items nav pull-left\">\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"main-logo\">\n <a href=\"https://kauaihumane.org/\" title=\"Kaua’i Humane Society\"></a>\n </div> </div>\n </li>\n </ul>\n <ul class=\"logobar-items nav pull-right\">\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"header-phone\"><span class=\"fa fa-phone\"></span> 808-555-0100</div> </div>\n </li>\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"header-email\"><span class=\"fa fa-envelope-o\"></span> <a href=\"mailto:someone@example.org\">someone@example.org</a></div> </div>\n </li>\n <li class=\"nav-item\">\n <div class=\"nav-item-inner\">\n <div class=\"header-address\"><span class=\"fa fa-map-marker\"></span> 3-825 Kaumualii Hwy, Lihue, HI 96766\n| Mail: PO Box 3330, Lihue, HI 96766</div> </div>\n </li>\n </ul>\n </div>\n </div>\n </div>\n\t</header>\n\t<div class=\"breno-content-wrapper\"><div class=\"breno-content breno-page\">\n <div class=\"breno-content-inner\">\n <div class=\"container\">\n <div class=\"row\">\n <div class=\"col-md-12 page-has-no-sidebar\">\n <div id=\"primary\" class=\"content-area\">\n <div class=\"row event\">\n <div class=\"col-sm-12 event-inner event-modal-1\">\n <div class=\"alert alert-warning event-closed\" role=\"alert\">\n <span class=\"fa fa-exclamation-triangle\"></span>Event closed. </div>\n <div class=\"row\">\n <div class=\"col-md-8 col-sm-12\">\n <div class=\"event-image-wrap\">\n <div class=\"event-img\">\n </div>\n </div> \n <div class=\"event-content-wrap\">\n <div class=\"event-title\">\n </div>\n <div class=\"team-content\">\n <div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid vc_custom_1549694235085\"><div class=\"wpb_column vc_column_container vc_col-sm-12\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_text_column wpb_content_element vc_custom_1780451206813\">\n <div class=\"wpb_wrapper\">\n <h3 data-start=\"123\" data-end=\"192\">Kaua‘i Humane Society’s 2027 Photo Fundraiser &amp; Pet Calendar</h3>\n<p data-start=\"194\" data-end=\"307\">Every year, the Kaua‘i Humane Society creates an annual calendar—and this year, your pet could be featured!</p>\n<p data-start=\"309\" data-end=\"585\">Our <strong data-start=\"313\" data-end=\"353\">2027 Photo Fundraiser &amp; Pet Calendar</strong> is now open for entries and voting. It’s your chance to show off your pet <em data-start=\"428\" data-end=\"433\">and</em> help shelter animals at the same time. All pets from across the U.S. are welcome to participate, and proceeds directly support the animals in our care.</p>\n<p data-start=\"587\" data-end=\"638\">Help us make this year’s calendar the most impactful one yet for animals in need!</p>\n </div>\n\t</div>\n<div class=\"vc_empty_space\"><span class=\"vc_empty_space_inner\"></span></div></div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid\"><div class=\"wpb_column vc_column_container vc_col-sm-12\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\"><div class=\"btn-wrap\"><a href=\"https://www.gogophotocontest.com/kauaihumanesociety2027\" class=\"btn breno-btn btn-default \" data-css=\"&quot;&quot;\">View Contest Page</a></div></div></div></div></div>\n</div> </div> \n </div>\t\n </div>\n <div class=\"col-md-4 col-sm-12\">\n <div class=\"event-info-wrap\">\n\t<div class=\"row\">\n <div class=\"col-sm-12\">\n <div class=\"event-info\">\n <h4>Event Details</h4>\n <p class=\"event-organizer\">\n <span class=\"event-subtitle\">\n <strong>Organizer : \n </strong>\n </span>\n Kaua`i Humane Society </p> <p class=\"event-start-date\">\n <span class=\"event-subtitle\">\n <strong>Start Date : \n </strong>\n </span>\n 2026-06-01 </p> <p class=\"event-end-date\">\n <span class=\"event-subtitle\">\n <strong>End Date : \n </strong>\n </span>\n 2026-08-30 </p> <p class=\"event-time\">\n <span class=\"event-subtitle\">\n <strong>Time : \n </strong>\n </span>\n 12:00 am </p> <p class=\"event-cost\">\n <span class=\"event-subtitle\">\n <strong>Cost : \n </strong>\n </span>\n $30 entry fee (includes free calendar) </p> <p class=\"event-cost\">\n <span class=\"event-subtitle\">\n <strong>More About Event : \n </strong>\n </span>\n <a class=\"btn btn-default\" href=\"https://www.gogophotocontest.com/kauaihumanesociety2027\" target=\"_blank\">Enter Your Pet Today</a>\n </p> </div>\n </div>\n <div class=\"col-sm-12\">\n <div class=\"event-venue\">\n <h4>Event Venue</h4>\n <p class=\"event-venue-name\">\n <span class=\"event-subtitle\">\n <strong>Venue : \n </strong>\n </span>\n Online Fundraiser </p> <p class=\"event-email\">\n <span class=\"event-subtitle\">\n <strong>E-mail : \n </strong>\n </span>\n someone@example.org </p> <p class=\"event-phone\">\n <span class=\"event-subtitle\">\n <strong>Phone : \n </strong>\n </span>\n 808-555-0100 </p> <p class=\"event-website\">\n <span class=\"event-subtitle\">\n <strong>Website : \n </strong>\n </span>\n <a href=\"https://kauaihumane.org/service/veterinary-services/\" target=\"_blank\">https://kauaihumane.org/service/veterinary-services/</a>\n </p> </div>\n </div>\n\t</div>\n</div>\n </div>\n </div>\n <div class=\"custom-post-nav\">\n <div class=\"prev-nav-link\">\n <a href=\"https://kauaihumane.org/event/hale-lihue/\" class=\"prev\"><i class=\"flaticon-long-left-arrow\"></i><p>Back to Post</p></a>\n </div>\n <a href=\"#\" class=\"disabled\"><i class=\"fa fa-angle-double-right\"></i></a>\n </div>\n </div>\n\t</div>\n </div>\n </div>\n </div>\n </div>\n\t</div>\n</div>\n\t</div>\n</div>\n</body></html><!-- Cached by WP-Optimize (gzip) - https://teamupdraft.com/wp-optimize/ - Last modified: September 18, 2026 12:15 am (UTC:0) -->"
