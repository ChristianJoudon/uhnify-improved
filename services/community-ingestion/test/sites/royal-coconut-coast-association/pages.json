   "text": "<!DOCTYPE html><html dir=\"ltr\" lang=\"en-US\"><head>\n <title>Kauai Events and Entertainment on the Royal Coconut Coast</title>\n <script type=\"application/ld+json\" class=\"aioseo-schema\">\n {\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#breadcrumblist\",\"itemListElement\":[{\"@type\":\"ListItem\",\"@id\":\"https:\\/\\/royalcoconutcoast.com#listItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\/\\/royalcoconutcoast.com\",\"nextItem\":{\"@type\":\"ListItem\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#listItem\",\"name\":\"Coconut Coast Events\"}},{\"@type\":\"ListItem\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#listItem\",\"position\":2,\"name\":\"Coconut Coast Events\",\"previousItem\":{\"@type\":\"ListItem\",\"@id\":\"https:\\/\\/royalcoconutcoast.com#listItem\",\"name\":\"Home\"}}]},{\"@type\":\"Organization\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/#organization\",\"name\":\"Royal Coconut Coast\",\"description\":\"Kauai's Vibrant East Side\",\"url\":\"https:\\/\\/royalcoconutcoast.com\\/\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#webpage\",\"url\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/\",\"name\":\"Kauai Events and Entertainment on the Royal Coconut Coast\",\"description\":\"There's always plenty to do on the Coconut Coast: Concerts, craft fairs, special performances, farmer\\u2019s markets, cultural demonstrations and unique local events.\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/#website\"},\"breadcrumb\":{\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#breadcrumblist\"},\"image\":{\"@type\":\"ImageObject\",\"url\":\"https:\\/\\/royalcoconutcoast.com\\/wp-content\\/uploads\\/2023\\/12\\/Coconut-Coast-Events.jpg\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#mainImage\",\"width\":1400,\"height\":590,\"caption\":\"Coco Palms \\u00a9Kicka Witte\"},\"primaryImageOfPage\":{\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/kauai-events\\/#mainImage\"},\"datePublished\":\"2018-07-11T14:42:54-10:00\",\"dateModified\":\"2023-12-19T11:52:41-10:00\"},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/#website\",\"url\":\"https:\\/\\/royalcoconutcoast.com\\/\",\"name\":\"Royal Coconut Coast\",\"description\":\"Kauai's Vibrant East Side\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https:\\/\\/royalcoconutcoast.com\\/#organization\"}}]}\n </script>\n</head>\n<body class=\"wordpress y2026 m09 d18 h01 page pageid-2643 page-author-delicious\">\n<div id=\"wrapper\" class=\"hfeed \">\n\t<div id=\"header\">\n <div id=\"\" class=\"max_float\">\t\n <div id=\"logo\">\n <a href=\"/\"></a>\n </div>\n <a id=\"nav_open\"><i class=\"fa fa-bars\" aria-hidden=\"true\"></i>&nbsp; <span>MENU</span></a>\n <a id=\"nav_close\"><i class=\"fa-solid fa-circle-xmark\"></i>&nbsp; <span>MENU</span></a>\n </div>\n\t</div>\n\t<div id=\"header_navigation\">\n <div class=\"max_float\">\n <div id=\"translate\">\n <a class=\"japanese\" title=\"Japanese\" href=\"https://translate.google.com/translate?hl=&amp;sl=en&amp;tl=ja&amp;u=https%3A%2F%2Froyalcoconutcoast.com%2Fkauai-events%2F\"></a>\n <a class=\"german\" title=\"German\" href=\"https://translate.google.com/translate?hl=&amp;sl=en&amp;tl=de&amp;u=https%3A%2F%2Froyalcoconutcoast.com%2Fkauai-events%2F\"></a>\n <a class=\"french\" title=\"French\" href=\"https://translate.google.com/translate?hl=&amp;sl=en&amp;tl=fr&amp;u=https%3A%2F%2Froyalcoconutcoast.com%2Fkauai-events%2F\"></a>\n <a class=\"korean\" title=\"Korean\" href=\"https://translate.google.com/translate?hl=&amp;sl=en&amp;tl=ko&amp;u=https%3A%2F%2Froyalcoconutcoast.com%2Fkauai-events%2F\"></a>\n </div>\n <nav id=\"access_panel_top\" aria-label=\"primary\">\n <div id=\"menu\" class=\"x\"><ul id=\"menu-main-menu\" class=\"menu\"><li id=