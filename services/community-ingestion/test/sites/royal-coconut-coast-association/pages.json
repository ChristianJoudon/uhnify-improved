health-fitness/\">Health &amp; Fitness</a></li>\n\t<li id=\"menu-item-2528\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2528\"><a href=\"https://royalcoconutcoast.com/activities/hiking/\">Hiking</a></li>\n\t<li id=\"menu-item-2572\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2572\"><a href=\"https://royalcoconutcoast.com/activities/historic-trails/\">Historic Trails</a></li>\n\t<li id=\"menu-item-7035\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-7035\"><a href=\"https://royalcoconutcoast.com/activities/kauai-horseback-tours/\">Horseback Tours</a></li>\n\t<li id=\"menu-item-2530\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2530\"><a href=\"https://royalcoconutcoast.com/activities/kayaking/\">Kayaking &amp; SUP</a></li>\n\t<li id=\"menu-item-2716\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2716\"><a href=\"https://royalcoconutcoast.com/activities/land-tours/\">Land Tours</a></li>\n\t<li id=\"menu-item-2531\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2531\"><a href=\"https://royalcoconutcoast.com/activities/luau/\">Luau</a></li>\n\t<li id=\"menu-item-6054\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-6054\"><a href=\"https://royalcoconutcoast.com/activities/kauai-massage/\">Massage</a></li>\n\t<li id=\"menu-item-7036\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-7036\"><a href=\"https://royalcoconutcoast.com/activities/scuba-diving/\">SCUBA Diving</a></li>\n\t<li id=\"menu-item-5539\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-5539\"><a href=\"https://royalcoconutcoast.com/activities/surfing/\">Surfing</a></li>\n\t<li id=\"menu-item-2887\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2887\"><a href=\"https://royalcoconutcoast.com/activities/swimming-snorkeling/\">Swimming &amp; Snorkeling</a></li>\n\t<li id=\"menu-item-2584\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2584\"><a href=\"https://royalcoconutcoast.com/activities/tubing/\">Tubing</a></li>\n\t<li id=\"menu-item-2583\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2583\"><a href=\"https://royalcoconutcoast.com/activities/zipline/\">Zipline</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2906\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-2906\"><a href=\"https://royalcoconutcoast.com/food-and-dining/\">Eat</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-2709\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2709\"><a href=\"https://royalcoconutcoast.com/food-and-dining/restaurants-dining/\">Restaurants</a></li>\n\t<li id=\"menu-item-2707\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2707\"><a href=\"https://royalcoconutcoast.com/food-and-dining/food-specialties-tours/\">Food Specialties &amp; Tours</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2536\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2536\"><a href=\"https://royalcoconutcoast.com/shopping/\">Shop</a></li>\n<li id=\"menu-item-2699\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2699\"><a href=\"https://royalcoconutcoast.com/services/weddings/\">Weddings</a></li>\n<li id=\"menu-item-2537\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-2537\"><a href=\"https://royalcoconutcoast.com/services/\">Services</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-2703\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2703\"><a href=\"https://royalcoconutcoast.com/services/beauty/\">Beauty &amp; Spas</a></li>\n\t<li id=\"menu-item-2702\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2702\"><a href=\"https://royalcoconutcoast.com/services/finance-and-real-estate/\">Finance &amp; Real Estate</a></li>\n\t<li id=\"menu-item-2700\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2700\"><a href=\"https://royalcoconutcoast.com/services/transportation/\">Transportation</a></li>\n\t<li id=\"menu-item-3675\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-3675\"><a href=\"https://royalcoconutcoast.com/services/nonprofit-resources/\">Nonprofit Resources</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2835\" class=\"menu-item menu-item-type-custom menu-item-object-custom current-menu-ancestor current-menu-parent menu-item-has-children menu-item-2835\"><a>Events &amp; News</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-2645\" class=\"menu-item menu-item-type-post_type menu-item-object-page current-menu-item page_item page-item-2643 current_page_item menu-item-2645\"><a href=\"https://royalcoconutcoast.com/kauai-events/\" aria-current=\"page\">Events</a></li>\n\t<li id=\"menu-item-2575\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2575\"><a href=\"https://royalcoconutcoast.com/kauai-info/news-items/\">Member News</a></li>\n\t<li id=\"menu-item-2576\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2576\"><a href=\"https://royalcoconutcoast.com/kauai-info/press-room-media/\">Press Room</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2718\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-2718\"><a>RCCA</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-2719\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2719\"><a href=\"https://royalcoconutcoast.com/membership-info/\">Membership Information</a></li>\n\t<li id=\"menu-item-2720\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2720\"><a href=\"https://royalcoconutcoast.com/connec/\">Contact Us</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-2570\"><a href=\"https://royalcoconutcoast.com/kauai-map/\">Map</a></li>\n</ul></div> <li id=\"menu-item-9999\" class=\"menu-item menu-item-9999\"><a href=\"https://www.kauai.gov/ADA\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-solid fa-wheelchair-move\"></i>&nbsp; ADA Travel Info</a></li>\n <div class=\"social_header\">\n <a class=\"facebook\" href=\"https://www.facebook.com/RoyalCoconutCoastKauai\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n <a class=\"instagram\" href=\"https://www.instagram.com/royalcoconutcoastkauai/\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-brands fa-instagram\"></i></a>\n <a class=\"twitter\" href=\"https://twitter.com/RoyalCoconut\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n <a class=\"youtube\" href=\"https://www.youtube.com/channel/UCxnngbbWEe1lWH6_LCeaoKA?spfreload=10\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-brands fa-youtube\"></i></a>\n <a class=\"pinterest\" href=\"https://www.pinterest.com/royalcoconutcoa/\" rel=\"noopener\" target=\"_blank\"><i class=\"fa-brands fa-pinterest\"></i></a>\n <a class=\"blogger\" href=\"/kauai-info/blog/\"><i class=\"fa-brands fa-blogger-b\"></i></a>\n </div> \n </nav>\n </div>\n\t</div>\n\t<div id=\"billboard\" class=\"sub_page\">\n <div class=\"dd_cycle-slideshow\">\n <div class=\"featured_image\"><p>Coco Palms \u00a9Kicka Witte</p></div>\n </div>\n\t</div>\n\t<div class=\"container foam \">\n <div class=\"content min_float member_category_content\">\n <div id=\"post-2643\" class=\"post hentry p1 page publish author-delicious untagged y2018 m07 d11 h04\">\n <div class=\"entry_content member_category\" role=\"main\">\n<h1>Coconut Coast Events</h1>\n<p>Every week on the Royal Coconut Coast there are concerts, craft fairs, special performances, farmer\u2019s markets, interesting lectures, cultural demonstrations and delightful local events. The monthly First Saturday Art Walk is highly popular. Several major events also come to the area throughout the year, providing full weekends of festival-fun. And, there are a number of community events that always welcome visitors. Check out our ongoing list of featured events, and don\u2019t miss going to <a href=\"https://KauaiFestivals.com/\" target=\"_blank\" rel=\"noopener\">KauaiFestivals.com</a> for a complete list of island-wide happenings.</p>\n </div>\n </div>\n </div>\n\t</div>\n<div class=\"clr\"></div>\n<div class=\"container white\"><div class=\"content max_float events\"> <div id=\"post-6685\" class=\"flex_space-between single_event_block\">\n <div class=\"image_container\">\n <a href=\"https://royalcoconutcoast.com/kauai-events/kauai-mokihana-festival-sept-20-26/\" class=\"ga_event\"></a>\n </div>\n <div class=\"verbose_container\">\n <h3><a href=\"https://royalcoconutcoast.com/kauai-events/kauai-mokihana-festival-sept-20-26/\">Kauai Mokihana Festival -- Sept 20 - 26</a></h3>\n <p class=\"event_date\">September 20th to 26th</p>\n <div></div>\n<p>The <a href=\"https://www.maliefoundation.org/kaua-i-mokihana-festival\">Kauai Mokihana Festival</a> is a time-honored week-long celebration of Hawaiian culture, including educational lectures, music, chants and the end-of-week hula competition. This year\u2019s theme is \u201cA Year of Songs and Chants of Hawaii.\u201d A Hawaiian church service starts the week off at the historic <a href=\"https://kfhc.org/\">Kapaa First Hawaiian Church on the 20th, </a> followed by a workshop on Oli (chant) on Monday. Then a composers contest and concert is on tap at the <a href=\"https://www.marriott.com/en-gb/hotels/travel/lihsk-sheraton-kauai-coconut-beach-resort/?hybridAEMFallbackRedirect=true\">Sheraton Kauai Coconut Beach</a><a href=\"https://www.marriott.com/en-gb/hotels/travel/lihsk-sheraton-kauai-coconut-beach-resort/?hybridAEMFallbackRedirect=true\"> on the 26h.&nbsp;&nbsp;</a> Thursday Friday and Saturday bring a hula workshop and the hula competition in Lihue. Join in \u2014 public welcome!&nbsp; Tickets for events are available at <a href=\"https://www.vickysfabrics.com/\">Vicky\u2019s Fabrics in Kapaa</a>, <span class=\"LrzXr\">4-1326 Kuhio Hwy, Kapa\u02bba, HI 96746. Tickets are $30 to $40.</span></p>\n<p>\u2022 Sunday, September 20th, 10:00 am \u2014 Hawaiian Church Service at the historic Kapa\u2018a First Hawaiian Church.</p>\n<p>September 21st: 5:30PM Kauai Composer\u02bbs Contest &amp; Concert at the Outrigger Kauai Beach Resort &amp; Spa.</p>\n<p>September 22nd: Eo e Lili`u Workshop at Liliuokalani Trust in Lihue for participating Hawaiian Language schools.</p>\n<p>September 23rd: Workshop (to be announced).</p>\n<p>September 24th: 10AM Mokihana Makeke (Craft Fair &amp; Food) &amp; 5PM Hula Competition \u2013 Group &amp; Solo Kahiko at Kauai War Memorial Convention Hall.</p>\n<p>September 25th: 10AM Mokihana Makeke (Craft Fair &amp; Food) &amp; 5PM Hula Competition \u2013 Group Auana at Kauai War Memorial Convention Hall.</p>\n<p>September 26th: 10AM Mokihana Makeke (Craft Fair &amp; Food) &amp; 10AM Hula Competition \u2013 Solo Auana &amp; Awards Ceremony at Kauai War Memorial Convention Hall</p>\n<p>Check out full details at https://www.maliefoundation84.org/</p>\n<p>Photo courtesy of the Malie Foundation</p>\n<p>&nbsp;</p>\n <div class=\"event_details\">\n <h4>Event Details</h4>\n <p>\n <strong>When: </strong>September 20th to 26th<br>\n <strong>Location: </strong>Kapaa and Lihue<br>\n <strong>Organizer: </strong>Malie Foundation<br><strong>Telephone: </strong><a href=\"tel:8085550100\">808-555-0100 </a><br>\n <strong>Website: </strong><span class=\"event_url\"><a href=\"https://www.maliefoundation84.org/\" target=\"_blank\" rel=\"noopener\" class=\"ga_event\">https://www.maliefoundation84.org/</a></span><br>\n </p>\n </div>\n <a class=\"button blue\" href=\"https://royalcoconutcoast.com/kauai-events/kauai-mokihana-festival-sept-20-26/\"><i class=\"fa-regular fa-calendar-days\"></i> Event Info</a>\n </div>\n </div>\n <hr class=\"x_margin\"> <div id=\"post-8720\" class=\"flex_space-between single_event_block\">\n <div class=\"image_container\">\n <a href=\"https://royalcoconutcoast.com/kauai-events/international-day-of-peace-rock-painting-sept-20th/\" class=\"ga_event\"></a>\n </div>\n <div class=\"verbose_container\">\n <h3><a href=\"https://royalcoconutcoast.com/kauai-events/international-day-of-peace-rock-painting-sept-20th/\">International Day of Peace Rock Painting - Sept 20th</a></h3>\n <p class=\"event_date\">September 20th, 1-3 p.m.</p>\n <p>Under the guidance of art instructor, Marionette,&nbsp; paint a rock with a message or image inspired by the International Day of Peace, on Sunday, September 20th from 1 to 3 p.m. at Painting Paradise in Lihue.&nbsp; The first rock is free.&nbsp; It can be used to start a peace rock garden; gift it to someone&nbsp; who needs peaceful energy, use it to start journaling, pay it forward to a random stranger or other personsl choices. The official International Day of Peace is September 21st.</p>\n<p>Space is limited so register by texting Marionette at 808-555-0100.</p>\n<p>Painting Paradise is located at 1824 Haleukana St, Lihue (Puhi Industrial Center)</p>\n <div class=\"event_details\">\n <h4>Event Details</h4>\n <p>\n <strong>When: </strong>September 20th, 1-3 p.m.<br>\n <strong>Location: </strong>1824 Haleukana St, Lihue (Puhi Industrial Center)<br>\n <strong>Organizer: </strong>Painting Paradise<br><strong>Contact: </strong>Marionette<br><strong>Telephone: </strong><a href=\"tel:8085550100\"> 808-555-0100 Painting Paradise is located at 1824 Haleukana St, Lihue (Puhi Industrial Center)</a><br>\n <strong>Website: </strong><span class=\"event_url\"><a href=\"https://kauaiartclasses.blogspot.com/\" target=\"_blank\" rel=\"noopener\" class=\"ga_event\">https://kauaiartclasses.blogspot.com/</a></span><br>\n </p>\n </div>\n <a class=\"button blue\" href=\"https://royalcoconutcoast.com/kauai-events/international-day-of-peace-rock-painting-sept-20th/\"><i class=\"fa-regular fa-calendar-days\"></i> Event Info</a>\n </div>\n </div>\n <hr class=\"x_margin\"> <div id=\"post-8705\" class=\"flex_space-between single_event_block\">\n <div class=\"image_container\">\n <a href=\"https://royalcoconutcoast.com/kauai-events/sound-bath-and-yin-yoga-session-august-30/\" class=\"ga_event\"></a>\n </div>\n <div class=\"verbose_container\">\n <h3><a href=\"https://royalcoconutcoast.com/kauai-events/sound-bath-and-yin-yoga-session-august-30/\">Sound Bath and Yin Yoga Session - Sept. 27th</a></h3>\n <p class=\"event_date\">September 27th, 8:30 to 9:30 a.m.</p>\n <p>Every Sunday,&nbsp; join Anya Love for a Special Sound Bath and Yin Yoga session near the ocean, with crystal bowls and led by Anya Love, owner of Kauai On the Beach Yoga. This runs from 8:30 to 9:30 at the Kauai Shores Hotel. Cost is $25. For more information go to https://kauaiyogaonthebeach.com</p>\n<p>Relax and fall deep into your own restorative yoga universe with a crystal bowl sound meditation. A blissful state of consciousness and a very relaxed body are achievable through this experience. Relaxing yet elevating harmonic pure tones offer a rejuvenating break from busy lives. Anya is dedicated to creating an experience of healing and balance.</p>\n<p>With the help of Anya\u2019s magical crystal bowls and gentle, slow yin yoga, you are able to cultivate an inner harmony and discover answers from within.</p>\n<p>Benefits include:</p>\n<p>\u2022 Physical, Spiritual &amp; Emotional Balance<br>\n\u2022 A Clear Mind with Increased Focus<br>\n\u2022 Feeling Lighter, Not Tighter in Your Body<br>\n\u2022 Deeper appreciation of Self<br>\n\u2022 Restful Sleep<br>\n\u2022 Stress Relief<br>\n\u2022 Harmony and Flow<br>\n\u2022 Deep Relaxing Meditation Technique</p>\n <div class=\"event_details\">\n <h4>Event Details</h4>\n <p>\n <strong>When: </strong>September 27th, 8:30 to 9:30 a.m.<br>\n <strong>Location: </strong>Kauai Shores Hotel, Kapaa<br>\n <strong>Organizer: </strong>Kauai Yoga On The Beach<br><strong>Contact: </strong>Anya Love<br><strong>Email: </strong><a href=\"mailto:someone@example.org\">someone@example.org</a><br><strong>Telephone: </strong><a href=\"tel:8085550100\">808-555-0100 </a><br>\n <strong>Website: </strong><span class=\"event_url\"><a href=\"https://kauaifestivals.com/festival/sunday-special-sound-bath-yin-yoga/2026-08-30/\" target=\"_blank\" rel=\"noopener\" class=\"ga_event\">https://kauaifestivals.com/festival/sunday-special-sound-bath-yin-yoga/2026-08-30/</a></span><br>\n </p>\n </div>\n <a class=\"button blue\" href=\"https://royalcoconutcoast.com/kauai-events/sound-bath-and-yin-yoga-session-august-30/\"><i class=\"fa-regular fa-calendar-days\"></i> Event Info</a>\n </div>\n </div>\n <hr class=\"x_margin\"> <div id=\"post-6060\" class=\"flex_space-between single_event_block\">\n <div class=\"image_container\">\n <a href=\"https://royalcoconutcoast.com/kauai-events/kauai-yoga-peace-festival-oct-3rd/\" class=\"ga_event\"></a>\n </div>\n <div class=\"verbose_container\">\n <h3><a href=\"https://royalcoconutcoast.com/kauai-events/kauai-yoga-peace-festival-oct-3rd/\">Kauai Yoga &amp; Peace Festival -- October 3rd</a></h3>\n <p class=\"event_date\">October 3rd, 8 am to 5 pm</p>\n <p>Join in, on October 3rd, 2026, at the lovely oceanfront <a href=\"https://www.kauaishoreshotel.com/\">Kauai Shores Hotel</a> for the <a href=\"https://alohafestival.org\">Kauai Aloha Yoga and Peace Festival</a> . Events run from 8 a.m. to 5 p.m. This is a full day of yoga classes, meditations, sound healing, booths, acoustic music, healing arts, and a yoga tribe gathering. Connect with like-minded individuals in a collective field of peace, nature, and synchronicity on the sacred island of Kauai.The organizers seek to create a welcoming and inclusive space where everyone can explore and deepen their practice, regardless of their level of experience.</p>\n<p>The Island of Kauai amplifies the divine energy of Aloha, making it the perfect setting to share yoga and meditation practices. Unite with other light-workers from around the world and experience the teachings, speakers, artists, and local talents committed to awakening humanity. Our festival overlooks the stunning Pacific Ocean, the sacred Wailua River, and ancient Hawaiian Heiaus (temples under the open sky).</p>\n<p>Ticket cost: $20 to $108. Parking is limited (Kauai Shores Hotel parking is for hotel guests). Please car pool, walk or bike. Go here to purchase tickets and find out more: <a href=\"https://www.alohafestival.org/\">https://www.alohafestival.org/</a></p>\n<p>&nbsp;</p>\n<p></p>\n<p>&nbsp;</p>\n <div class=\"event_details\">\n <h4>Event Details</h4>\n <p>\n <strong>When: </strong>October 3rd, 8 am to 5 pm<br>\n <strong>Location: </strong>Kauai Shores Hotel, Kapaa<br>\n <strong>Organizer: </strong>Kauai Aloha &amp; Peade Festival<br><strong>Email: </strong><a href=\"mailto:someone@example.org\">someone@example.org</a><br>\n <strong>Website: </strong><span class=\"event_url\"><a href=\"https://www.alohafestival.org/\" target=\"_blank\" rel=\"noopener\" class=\"ga_event\">https://www.alohafestival.org/</a></span><br>\n </p>\n </div>\n <a class=\"button blue\" href=\"https://royalcoconutcoast.com/kauai-events/kauai-yoga-peace-festival-oct-3rd/\"><i class=\"fa-regular fa-calendar-days\"></i> Event Info</a>\n </div>\n </div>\n <hr class=\"x_margin\"> <div id=\"post-4224\" class=\"flex_space-between single_event_block\">\n <div class=\"image_container\">\n <a href=\"https://royalcoconutcoast.com/kauai-events/queen-emalani-festival-november-7th-10th/\" class=\"ga_event\"></a>\n </div>\n <div class=\"verbose_container\">\n <h3><a href=\"https://royalcoconutcoast.com/kauai-events/queen-emalani-festival-november-7th-10th/\">Eo E Emalani Festival -- November 7th</a></h3>\n <p class=\"event_date\">November 7th, 10 a.m. to 4 p.m.</p>\n <div class=\"tribe-events-single-event-description tribe-events-content\">\n<p data-start=\"0\" data-end=\"129\">The <strong data-start=\"4\" data-end=\"36\">38th Annual Emalani Festival</strong> takes place on <strong data-start=\"52\" data-end=\"126\">Saturday, November 7, 2026, in K\u014dke\u2018e, Kaua\u2018i, from 9:00 AM to 4:00 PM</strong>.</p>\n<p data-start=\"131\" data-end=\"357\">Tents featuring lei-making, exhibits, and food will surround the performance and seating area, creating an immersive cultural experience. Hawaiian music begins at 9:00 AM, setting the stage for the day\u2019s festivities.</p>\n<p data-start=\"359\" data-end=\"791\">At the heart of the festival is the arrival of Queen Emma, her attendant, and her guide, Kaluahi, on horseback at 10:00 AM. Protocol ceremonies will pay homage to the Queen, with performances dedicated to her throughout the day. In a special moment, the Queen may offer a dance of her own. Sponsors and guests are invited to witness this historical event, authentic Hawaiian protocol, and genuine Hawaiian cuisine.</p>\n<p data-start=\"793\" data-end=\"1066\">The event remains free to attend, but VIP packages will be available on the E\u014d e Emalani website <a href=\"https://www.eventeny.com/events/ticket/?id=23479\">https://www.eventeny.com/events/ticket/?id=23479</a>. VIP tickets are designed to encourage attendees to use the shuttle service, reducing traffic, parking congestion, and the overall carbon footprint in K\u014dke\u2018e.</p>\n<h3 data-start=\"1068\" data-end=\"1098\">VIP Tickets Include:</h3>\n<ul data-start=\"1099\" data-end=\"1336\">\n<li data-start=\"1099\" data-end=\"1170\">Shuttle service from Kekaha Neighborhood Center (Park and Ride)</li>\n<li data-start=\"1171\" data-end=\"1257\">VIP covered seating (bench seating under cover, fronting the performance area)</li>\n<li data-start=\"1258\" data-end=\"1313\">VIP meal (catered by H\u0101lau Ka P\u0101 Hula O Hinano)</li>\n<li data-start=\"1314\" data-end=\"1336\">Festival shirt</li>\n</ul>\n<p data-start=\"1338\" data-end=\"1426\" data-is-last-node=\"\" data-is-only-node=\"\">Supported by the Hawai\u2018i Tourism Authority through its Community Enrichment Program.</p>\n</div>\n <div class=\"event_details\">\n <h4>Event Details</h4>\n <p>\n <strong>When: </strong>November 7th, 10 a.m. to 4 p.m.<br>\n <strong>Location: </strong>Kokee Museum, Kokee State Park<br>\n <strong>Organizer: </strong>Historic Waimea Theater and Cultural Arts Center <br><strong>Email: </strong><a href=\"mailto:someone@example.org\">someone@example.org</a><br><strong>Telephone: </strong><a href=\"tel:8085550100\">808-555-0100 </a><br>\n <strong>Website: </strong><span class=\"event_url\"><a href=\"https://kauaifestivals.com/festival/e-o-emalani/\" target=\"_blank\" rel=\"noopener\" class=\"ga_event\">https://kauaifestivals.com/festival/e-o-emalani/</a></span><br>\n </p>\n </div>\n <a class=\"button blue\" href=\"https://royalcoconutcoast.com/kauai-events/queen-emalani-festival-november-7th-10th/\"><i class=\"fa-regular fa-calendar-days\"></i> Event Info</a>\n </div>\n </div>\n <hr class=\"x_margin\"></div></div>\n\t<div class=\"container white\">\n <div class=\"content max_float flex_space-between categories\">\n <a id=\"explore\" class=\"big_icon\" href=\"/kauai-coconut-coast/\">\n <div class=\"icon_label\">Explore</div>\n <div class=\"image_container\"></div>\n </a>\n <a id=\"stay\" class=\"big_icon\" href=\"/hotels-condos-rentals/\">\n <div class=\"icon_label\">Stay</div>\n <div class=\"image_container\"></div>\n </a>\n <a id=\"play\" class=\"big_icon\" href=\"/activities/\">\n <div class=\"icon_label\">Play</div>\n <div class=\"image_container\"></div>\n </a>\n <a id=\"eat\" class=\"big_icon\" href=\"/food-and-dining/\">\n <div class=\"icon_label\">Eat</div>\n <div class=\"image_container\"></div>\n </a>\n <a id=\"shop\" class=\"big_icon\" href=\"/shopping/\">\n <div class=\"icon_label\">Shop</div>\n <div class=\"image_c