   "text": "[{\"id\":12269,\"title\":\"International Day of Peace Rock Painting Event  -  FREE\",\"address\":\"1824 Haleukana St.\",\"active\":true,\"expired\":false,\"approved\":true,\"submitted\":true,\"calendarID\":\"kauai\",\"category\":\"Arts & Culture,Community,Free,Kid Friendly,Educational\",\"description\":\"<p><span style=\\\"mso-spacerun: yes;\\\">Under the guidance of art instructor, Marionette, you can paint a rock with a message or image inspired by the International Day of Peace which is September 21.&nbsp; First rock is free.&nbsp; You can then use it to start a peace rock garden, gift it to someone who needs peaceful energy, use it as a prompt for a journaling exercise, or pay it forward to a random stranger just to name a few of the ways to celebrate this special day.</span></p>\\r\\n<p>Space is limited so register by texting Marionette at 808-555-0100<br />Painting Paradise is located at 1824 Haleukana St, Lihue (Puhi Industrial Center)</p>\",\"region\":\"Lihue\",\"latitude\":21.9572,\"longitude\":-159.393,\"eventHash\":\"u2z6a9i4g3i5n\",\"featured\":false,\"image\":\"https://media.hubhawaii.com/photo818718645_1786052250451_1786052253088.webp\",\"additionalImages\":\"\",\"plan\":\"basic\",\"userid\":28228,\"website\":\"https://kauaiartclasses.blogspot.com/\",\"stripecustomerid\":null,\"userEmail\":\"someone@example.org\",\"downgradeDate\":null,\"downgradeDelete\":null,\"timeAdded\":\"2026-08-06T21:38:11.000Z\",\"timeUpdated\":\"2026-08-07T00:45:00.000Z\",\"dates\":[{\"id\":27349,\"date\":\"9-20-2026\",\"calendarID\":\"kauai\",\"dateString\":\"Sun, Sep 20, 2026\",\"dateStringLong\":\"Sunday, September 20, 2026\",\"timeString\":\"1:00 pm - 3:00 pm\",\"endTime\":54000000,\"startTime\":46800000,\"repeat_day\":null,\"repeat_date\":null,\"repeat_day_week\":null,\"repeat_until\":null,\"timestamp\":1789862400000,\"eventId\":12269}]},{\"id\":11197,\"title\":\"DA GRUV at SUNSET LANAI!\",\"address\":\"Anaina Hou Community Park - 5-2723 Kūhiō Hwy, Kīlauea, HI 