   "text": "[{\"id\":11404,\"title\":\"Improv & Open Mic Community Nights\",\"address\":\"4411 Kikowaena St.\",\"active\":true,\"expired\":false,\"approved\":true,\"submitted\":true,\"calendarID\":\"kauai\",\"category\":\"Arts & Culture,Community,Kid Friendly\",\"description\":\"<p>Hawaii Children&rsquo;s Theatre and Kauaʻi Community Players present Improv Night &amp; Open Mic! Join us for a fun, creative evening of theatre games, improv, and open mic performances. Kids are invited from 5:30 to 6:30 pm for Improv/Open Mic, followed by Adults Improv from 7:00 to 8:30 pm and Open Mic at 8:30 pm. Dates are Fridays: June 19, July 17, Sept. 18, and Oct. 16. $5 pay at the door.</p>\",\"region\":\"Lihue\",\"latitude\":21.9644,\"longitude\":-159.396,\"eventHash\":\"n8l8t4q3h5a4i\",\"featured\":false,\"image\":\"https://media.hubhawaii.com/photo393719021_1780357813098_1780357813647.webp\",\"additionalImages\":\"\",\"plan\":\"basic\",\"userid\":24027,\"website\":\"\",\"stripecustomerid\":null,\"userEmail\":\"someone@example.org\",\"downgradeDate\":null,\"downgradeDelete\":null,\"timeAdded\":\"2026-06-01T23:50:17.000Z\",\"timeUpdated\":\"2026-06-02T00:56:27.000Z\",\"dates\":[{\"id\":25627,\"date\":\"9-18-2026\",\"calendarID\":\"kauai\",\"dateString\":\"Fri, Sep 18, 2026\",\"dateStringLong\":\"Friday, September 18, 2026\",\"timeString\":\"5:30 pm - 10:00 pm\",\"endTime\":79200000,\"startTime\":63000000,\"repeat_day\":null,\"repeat_date\":null,\"repeat_day_week\":null,\"repeat_until\":null,\"timestamp\":1789689600000,\"eventId\":11404}]},{\"id\":12323,\"title\":\"PRE-PARTY JUSTIN MORRIS & COMPANY at SUNSET LANAI!\",\"address\":\"Anaina Hou Community Park - 5-2723 Kūhiō Hwy, Kīlauea, HI 96754\",\"active\":true,\"expired\":false,\"approved\":true,\"submitted\":true,\"calendarID\":\"kauai\",\"category\":\"Music\",\"description\":\"<p class=\\\"MsoNormal\\\"><strong style=\\\"mso-bidi-font-weight: normal;\\\">SUNSET LANAI at ANAINA HOU COMMUNITY PARK</strong></p>\\r\\n<p class=\\\"M